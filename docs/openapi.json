  "components": {
    "schemas": {
      "NovaPauta": {
        "type": "object",
        "required": [
          "titulo"
        ],
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "descricao": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "Abertura": {
        "type": "object",
        "properties": {
          "duracaoMinutos": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10080,
            "default": 1
          }
        }
      },
      "NovoVoto": {
        "type": "object",
        "required": [
          "associadoId",
          "voto"
        ],
        "properties": {
          "associadoId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 100
          },
          "voto": {
            "type": "string",
            "enum": [
              "SIM",
              "NAO"
            ]
          },
          "cpf": {
            "type": "string",
            "pattern": "^(?:[0-9]{11})?$"
          }
        }
      },
      "Pauta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "titulo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "criadaEm": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Sessao": {
        "type": "object",
        "properties": {
          "pautaId": {
            "type": "string",
            "format": "uuid"
          },
          "abertaEm": {
            "type": "string",
            "format": "date-time"
          },
          "encerraEm": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Resultado": {
        "type": "object",
        "properties": {
          "pautaId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "NAO_ABERTA",
              "ABERTA",
              "ENCERRADA"
            ]
          },
          "sim": {
            "type": "integer",
            "format": "int64"
          },
          "nao": {
            "type": "integer",
            "format": "int64"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "resultado": {
            "type": "string",
            "enum": [
              "EMPATE",
              "APROVADA",
              "REJEITADA"
            ]
          }
        }
      },
      "Action": {
        "type": "object",
        "required": [
          "texto",
          "url",
          "body"
        ],
        "properties": {
          "texto": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "body": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Item": {
        "type": "object",
        "required": [
          "tipo"
        ],
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "TEXTO",
              "INPUT_TEXTO",
              "INPUT_NUMERO",
              "INPUT_DATA"
            ]
          },
          "id": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "texto": {
            "type": "string"
          },
          "valor": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        }
      },
      "Tela": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Formulario"
          },
          {
            "$ref": "#/components/schemas/Selecao"
          }
        ],
        "discriminator": {
          "propertyName": "tipo",
          "mapping": {
            "FORMULARIO": "#/components/schemas/Formulario",
            "SELECAO": "#/components/schemas/Selecao"
          }
        }
      },
      "Formulario": {
        "type": "object",
        "required": [
          "tipo",
          "titulo",
          "itens",
          "botaoOk"
        ],
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "FORMULARIO"
            ]
          },
          "titulo": {
            "type": "string"
          },
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "botaoOk": {
            "$ref": "#/components/schemas/Action"
          },
          "botaoCancelar": {
            "$ref": "#/components/schemas/Action"
          }
        }
      },
      "Selecao": {
        "type": "object",
        "required": [
          "tipo",
          "titulo",
          "itens"
        ],
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "SELECAO"
            ]
          },
          "titulo": {
            "type": "string"
          },
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
